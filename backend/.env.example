# Copy to backend/.env and fill in. Real environment variables override these values.
MYSQL_HOST=localhost
MYSQL_USER=myyt
MYSQL_PASSWORD=change-me
# Firebase project used for Google sign-in (Project settings → Project ID)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional
# MYSQL_PORT=3306
# MYSQL_DATABASE=myyt
# MYSQL_SSL_MODE=Required   # Disabled, Preferred (default), Required, VerifyCA, VerifyFull
